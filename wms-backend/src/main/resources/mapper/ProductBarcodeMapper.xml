<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yiweilai.wms.product.mapper.ProductBarcodeMapper">

    <resultMap id="BaseResultMap" type="com.yiweilai.wms.product.entity.ProductBarcode">
        <id column="id" property="id"/>
        <result column="sku_id" property="skuId"/>
        <result column="barcode" property="barcode"/>
    </resultMap>

    <select id="findBySkuId" resultMap="BaseResultMap">
        SELECT id, sku_id, barcode
        FROM product_barcode
        WHERE sku_id = #{skuId}
        ORDER BY id ASC
    </select>

    <select id="findByBarcode" resultMap="BaseResultMap">
        SELECT id, sku_id, barcode
        FROM product_barcode
        WHERE barcode = #{barcode}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product_barcode (sku_id, barcode)
        VALUES (#{skuId}, #{barcode})
    </insert>

    <delete id="deleteById">
        DELETE FROM product_barcode WHERE id = #{id}
    </delete>

    <delete id="deleteBySkuId">
        DELETE FROM product_barcode WHERE sku_id = #{skuId}
    </delete>

</mapper>
