<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yiweilai.wms.order.mapper.SalesOrderItemMapper">

    <resultMap id="BaseResultMap" type="com.yiweilai.wms.order.entity.SalesOrderItem">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="sku_id" property="skuId"/>
        <result column="sku_code" property="skuCode"/>
        <result column="sku_name" property="skuName"/>
        <result column="quantity" property="quantity"/>
        <result column="unit_price" property="unitPrice"/>
        <result column="total_price" property="totalPrice"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findByOrderId" resultMap="BaseResultMap">
        SELECT id, order_id, sku_id, sku_code, sku_name, quantity, unit_price, total_price, created_at
        FROM sales_order_item
        WHERE order_id = #{orderId}
        ORDER BY id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sales_order_item (order_id, sku_id, sku_code, sku_name, quantity, unit_price, total_price)
        VALUES (#{orderId}, #{skuId}, #{skuCode}, #{skuName}, #{quantity}, #{unitPrice}, #{totalPrice})
    </insert>

    <delete id="deleteByOrderId">
        DELETE FROM sales_order_item WHERE order_id = #{orderId}
    </delete>

</mapper>
