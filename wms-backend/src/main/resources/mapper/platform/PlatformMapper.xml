<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yiweilai.wms.platform.mapper.PlatformMapper">

    <resultMap id="BaseResultMap" type="com.yiweilai.wms.platform.entity.Platform">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="color" property="color"/>
        <result column="enabled" property="enabled"/>
        <result column="remark" property="remark"/>
        <result column="deleted" property="deleted"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <resultMap id="VOResultMap" type="com.yiweilai.wms.platform.vo.PlatformVO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="color" property="color"/>
        <result column="enabled" property="enabled"/>
        <result column="remark" property="remark"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findByPage" resultMap="VOResultMap">
        SELECT id, name, color, enabled, remark, created_at, updated_at
        FROM platform
        WHERE deleted = 0
        <if test="keyword != null and keyword != ''">
            AND name LIKE CONCAT('%', #{keyword}, '%')
        </if>
        <if test="enabled != null">
            AND enabled = #{enabled}
        </if>
        ORDER BY id DESC
    </select>

    <select id="findById" resultMap="BaseResultMap">
        SELECT id, name, color, enabled, remark, deleted, created_at, updated_at
        FROM platform
        WHERE id = #{id} AND deleted = 0
    </select>

    <select id="findByName" resultMap="BaseResultMap">
        SELECT id, name, color, enabled, remark, deleted, created_at, updated_at
        FROM platform
        WHERE name = #{name} AND deleted = 0
    </select>

    <select id="findEnabledList" resultMap="VOResultMap">
        SELECT id, name, color
        FROM platform
        WHERE deleted = 0 AND enabled = 1
        ORDER BY id DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO platform (name, color, enabled, remark)
        VALUES (#{name}, #{color}, #{enabled}, #{remark})
    </insert>

    <update id="update">
        UPDATE platform
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="color != null">color = #{color},</if>
            <if test="enabled != null">enabled = #{enabled},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        WHERE id = #{id} AND deleted = 0
    </update>

    <update id="deleteById">
        UPDATE platform SET deleted = 1 WHERE id = #{id}
    </update>

</mapper>
