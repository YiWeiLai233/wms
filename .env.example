# ============================================================
# WMS 环境变量配置模板
# 复制为 .env 后修改
# ============================================================

# ---- 必填 ----

# MySQL root 密码
MYSQL_ROOT_PASSWORD=Wms@2026

# JWT 密钥（生产环境必须修改！）
JWT_SECRET=WmsJwtSecret2026ChangeMeInProduction!
JWT_EXPIRATION=86400000

# ---- 可选 ----

# Redis 密码（默认无密码）
REDIS_PASSWORD=

# 文件访问地址（改成服务器实际 IP）
FILE_BASE_URL=http://localhost:8080
IMAGE_BASE_URL=http://localhost:8080/images

# AI 服务
AI_SERVICE_BASE_URL=http://localhost:8010
AI_SERVICE_TOKEN=ChangeMeAiServiceToken

# Swagger（生产环境建议关闭）
SWAGGER_ENABLED=false

# 日志级别: debug / info / warn / error
LOG_LEVEL=info

# 隐私加密密钥（生产环境必须修改！）
PRIVACY_MASTER_KEY=P3HBjvkFvIi7Q/MOLgHA32Fgx8eutYLL3sqMmTKKLE8=
PRIVACY_HASH_KEY=Td7H0vwQxi59YCQ8TpZXWpMiyS/lFadx2PMdQnLKuyU=

# ---- 可选功能 ----

# 百度 OCR
OCR_ENABLED=false
OCR_API_KEY=
OCR_SECRET_KEY=

# 快递100
EXPRESS_ENABLED=false
EXPRESS_KEY=
EXPRESS_CUSTOMER=
